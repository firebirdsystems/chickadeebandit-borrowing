        },
        {
          "action": "fault",
          "mode": "none",
          "as": "lender"
        },
        {
          "action": "reload",
          "as": "lender"
        },
        {
          "action": "expectText",
          "selector": "[data-testid=\"request-card\"][data-request-id=\"br-noop\"][data-request-status=\"pending\"]",
          "text": "Extension ladder",
          "as": "lender"
