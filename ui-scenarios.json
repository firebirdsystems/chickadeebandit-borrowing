    {
      "name": "a request that could not be sent stays in the form, draws no card, and sends once on the second try",
      "members": {
        "borrower": "adult",
        "lender": "adult"
      },
      "steps": [
        {
          "action": "open",
          "as": "borrower"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"from-me\"]",
          "as": "borrower"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"app-tab\"][data-tab=\"from-me\"]",
          "as": "borrower"
        },
        {
          "action": "expectText",
          "text": "You haven't made any borrow requests yet.",
          "as": "borrower"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"new-request\"]",
          "as": "borrower"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"field-item\"]",
          "as": "borrower"
        },
        {
          "action": "fill",
          "selector": "[data-testid=\"field-item\"]",
          "value": "Hedge trimmer",
          "as": "borrower"
        },
        {
          "action": "select",
          "selector": "[data-testid=\"field-lender\"]",
          "value": "{{lender}}",
          "as": "borrower"
        },
        {
          "action": "fill",
          "selector": "[data-testid=\"field-needed\"]",
          "value": "2026-11-01",
          "as": "borrower"
        },
        {
          "action": "fill",
          "selector": "[data-testid=\"field-return\"]",
          "value": "2026-11-05",
          "as": "borrower"
        },
        {
          "action": "fault",
          "mode": "down",
          "as": "borrower"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"save-request\"]",
          "as": "borrower"
        },
        {
          "action": "expectText",
          "selector": "[data-testid=\"modal-error\"]",
          "text": "Injected fault: database unavailable",
          "as": "borrower"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"field-item\"]",
          "as": "borrower"
        },
        {
          "action": "expectText",
          "text": "You haven't made any borrow requests yet.",
          "as": "borrower"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"request-card\"]",
          "count": 0,
          "as": "borrower"
        },
        {
